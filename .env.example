# OptiFlow — Supabase configuration (copy to .env.local, never commit real values)
# Browser code uses ONLY the publishable key. Never put a service-role
# (secret) key in this file, in the app bundle, or in git.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
# Legacy fallback if your project still uses anon keys:
# VITE_SUPABASE_ANON_KEY=eyJ...
